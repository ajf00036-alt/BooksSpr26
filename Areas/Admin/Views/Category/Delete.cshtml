@model Category

<h1>Delete Category</h1>

<div class="border col-md-10 mx-auto">

    <form asp-action="Delete">

        <input type="hidden" asp-for="CategoryId" />

        <div class="form-group row m-4">

            <label asp-for="Name" class="control-label col-md-2"></label>

            <div>

                <input asp-for="Name" disabbled class="form-control col-10" />
                <span asp-validation-for="Name" class="text-danger"></span>

            </div>

        </div>

        <div class="form-group row m-4">

            <label asp-for="Description" disabled class="control-label col-md-2"></label>

            <div>

                <input asp-for="Description" class="form-control col-10" />
                <span asp-validation-for="Description" class="text-danger"></span>

            </div>

        </div>

        <div class="form-group row m-4">

            <input type="submit" value="Delete Category" class="form-control btn btn-danger col-6" />

        </div>

    </form>

</div>