@model List<Category>

    <h1>Category List</h1>

    <table class="table table-bordered table-striped">
        <thead>

            <tr>

                <th>Name</th>
                <th>Description</th>

                <tbody>

                @foreach(var eachCategory in Model)
                {

                    <tr>

                        <td>@eachCategory.Name</td>
                        <td>@eachCategory.Description</td>
                        <th></th>

                        <td>

                    <a asp-controller="Category" asp-action="Edit" asp-route-id="@eachCategory.CategoryId">Edit</a> | <a asp-controller="Category" asp-action="Details" asp-route-id="@eachCategory.CategoryId">Details</a> | <a asp-controller="Category" asp-action="Delete" asp-route-id="@eachCategory.CategoryId">Delete</a>

                        </td>

                    </tr>

                }

                </tbody>

            </tr>

        </thead>

    </table>

    <div class="col-md-12 text-end">

        <a asp-controller="Category" asp-action="Create" class="btn btn-primary">Create New Category</a>

    </div>